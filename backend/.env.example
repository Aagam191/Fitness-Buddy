# ==========================================
# MyFit Backend Environment Configuration
# ==========================================

# Core Django Settings
SECRET_KEY=django-insecure-myfit-development-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,my-fit-backend-2.onrender.com

# ------------------------------------------
# Live Database Connection (Supabase / PostgreSQL)
# If provided and reachable, Django uses this live database.
# If unreachable or omitted, Django automatically falls back to local SQLite (db.sqlite3).
# ------------------------------------------
# Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Session Pooler Connection (Universally works on BOTH IPv4 and IPv6 networks):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
